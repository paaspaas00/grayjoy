<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-feature android:name="android.hardware.telephony" android:required="false" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="${grayjoyPackage}.permission.VOICE_CONTROL" />
    <uses-feature android:name="android.hardware.microphone" android:required="true" />
    <queries><package android:name="${grayjoyPackage}" /></queries>
    <application android:allowBackup="false" android:fullBackupContent="false" android:dataExtractionRules="@xml/no_backup" android:label="${voiceLabel}" android:supportsRtl="true" android:icon="@drawable/voice_icon" android:roundIcon="@drawable/voice_icon"
        android:theme="@android:style/Theme.Material.NoActionBar">
        <activity android:name=".VoiceSettingsActivity" android:exported="true">
            <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter>
            <intent-filter><action android:name="com.futo.platformplayer.voice.CONTROL" /><category android:name="android.intent.category.DEFAULT" /></intent-filter>
        </activity>
        <service android:name=".VoiceListeningService" android:exported="false" android:foregroundServiceType="microphone" />
        <service android:name=".VoiceMessageListener" android:exported="true" android:label="Messaggi per Grayjoy Voice"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter><action android:name="android.service.notification.NotificationListenerService" /></intent-filter>
        </service>
        <receiver android:name=".VoiceDisabledReceiver" android:exported="true" android:permission="${grayjoyPackage}.permission.VOICE_CONTROL">
            <intent-filter><action android:name="${grayjoyPackage}.VOICE_DISABLED" /></intent-filter>
        </receiver>
        <service android:name="androidx.work.impl.foreground.SystemForegroundService" android:foregroundServiceType="dataSync" />
    </application>
</manifest>
