{
  "name": "Radio Browser (Alpha)",
  "description": "Access over 50,000 radio stations from around the world through the community-driven radio-browser.info directory",
  "author": "FUTO",
  "authorUrl": "https://futo.org/",
  "platformUrl": "https://radio-browser.info",
  "sourceUrl": "https://plugins.grayjay.app/RadioBrowser/RadioBrowserConfig.json",
  "repositoryUrl": "https://gitlab.futo.org/videostreaming/plugins/radiobrowser",
  "scriptUrl": "./RadioBrowserScript.js",
  "version": 16,
  "iconUrl": "./RadioBrowserIcon.png",
  "id": "009775f8-9173-48a2-8df3-d730d08d198d",
  "scriptSignature": "",
  "scriptPublicKey": "",
  "packages": [
    "Http"
  ],
  "allowEval": false,
  "allowUrls": [
    ".api.radio-browser.info",
    "api.radiodb.fr"
  ],
  "changelog": {
    "16": [
      "Fix: Update API server to fallback list;"
    ],
    "10": [
      "Improvement: Add plugin setting filter the Home tab stations to a specific country;"
    ],
    "11": [
      "Fix: Request retry mechanism now correctly rotates to alternate servers on failure;"
    ],
    "12": [
      "Fix: Server rotation on request failure;"
    ],
    "13": [
      "Improvement: Search inside channels;"
    ],
    "14": [
      "Improvement: Remove some custom thumbnails for radio stations which users can select in the plugin settings."
    ],
    "15": [
      "Improvement: Use browser-compatible URLs for country channels;"
    ]
  },
  "settings": [
    {
      "variable": "submitActivity",
      "name": "Submit Activity",
      "description": "Submit activity to radio-browser.info to improve recommendations",
      "type": "Boolean",
      "default": "false"
    },
    {
      "variable": "thumbnailMode",
      "name": "Station Thumbnail Source",
      "description": "Choose which image source to use for station thumbnails",
      "type": "Dropdown",
      "default": "0",
      "options": [
        "Soundbar",
        "Platform Logo (Radio Browser)",
        "Country Flag",
        "Station Favicon (low quality)"
      ]
