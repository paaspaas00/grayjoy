  "changelog": {
    "18": [
      "Fix: Authorization token extraction causing playback errors;",
      "Improvement: Change authorUrl from futo.org to futo.tech;"
    ],
    "17": [
      "Fix: Use http impersonation to request media files;",
      "Improvement: Add iTunes API fallbacks for episode listings and episode details;",
      "Improvement: Add iTunes API fallbacks for regular podcast channel details;",
      "Improvement: Add best-effort iTunes API fallbacks for publisher channel playlists and episodes;"
    ],
    "16": [
      "Fix: Episodes pagination issue;",
      "Fix: Subscriber-only detection incorrectly checked duration instead of assetUrl;"
    ],
    "15": [
      "Fix: Update script filename regex to support new naming convention;",
      "Improvement: Add fallback to iTunes API for popular podcasts;"
    ],
    "14": [
      "Fix: Some subscriptions not being recognized as subscribed in channel details and media details;",
      "Improvement: Add support for embed channel URLs (embed.podcasts.apple.com);",
      "Improvement: Standardizes Apple Podcasts URL handling;"
    ],
    "13": [
      "Improvement: Add search autocomplete;",
      "Improvement: Include podcast channels (networks) in channel search results;"
    ],
    "12": [
      "Improvement: Add content recommendations and plugin setting to select source;",
      "Improvement: Show subscriber-only episodes as Locked content;",
      "Improvement: Add setting to hide subscriber-only episodes;",
      "Improvement: Add playlist tab to podcast channels containing all episodes;",
      "Improvement: Display top episodes from associated podcasts channels on publisher channels (network);",
      "Improvement: Add podcast information in episode description and podcast channels description;",
      "Improvement: Implement retry mechanism for improved network reliability;"
    ],
    "11": [
      "Use container type as source name;"
    ]
  }
