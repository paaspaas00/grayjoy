{
  "manifest_version": 3,
  "name": "Grayjoy Link",
  "description": "Transfer YouTube playback between Chrome and Grayjoy on your local network.",
  "version": "1.0.5",
  "minimum_chrome_version": "109",
  "permissions": [
    "storage",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "https://*.youtube.com/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Grayjoy Link",
    "default_popup": "popup.html"
  }
}
